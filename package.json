{
  "name": "furigana-maker",
  "description": "Add furigana to Japanese text on any page for learning kanji pronunciation.",
  "type": "module",
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9",
  "engines": {
    "node": ">=24.12.0"
  },
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Brian Zhou",
    "email": "brianzhou.dev@gmail.com"
  },
  "homepage": "https://furiganamaker.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiktb/furiganamaker.git"
  },
  "bugs": {
    "url": "https://github.com/aiktb/furiganamaker/issues"
  },
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write --unsafe .",
    "typecheck": "pnpm --recursive --sequential run typecheck",
    "test:unit": "pnpm --recursive --sequential run test:unit",
    "test:e2e": "pnpm --recursive --sequential run test:e2e:prod",
    "prepare": "lefthook install",
    "dev": "pnpm --filter extension run dev",
    "dev:firefox": "pnpm --filter extension run dev:firefox",
    "build": "pnpm --filter extension run build",
    "build:firefox": "pnpm --filter extension run build:firefox",
    "zip": "pnpm --filter extension run zip",
    "zip:firefox": "pnpm --filter extension run zip:firefox"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@types/node": "^26.5.1",
    "lefthook": "^2.1.12",
    "typescript": "^7.0.2"
  }
}
